@misc{nariya_unraveling_2024,
  title = {Unraveling the Oscillatory Dynamics of {{mRNA}} Metabolism and Chromatin Accessibility during the Cell Cycle through Integration of Single-Cell Multiomic Data},
  author = {Nariya, Maulik K. and {Santiago-Algarra}, David and Tassy, Olivier and Cerciat, Marie and Ye, Tao and Riba, Andrea and Molina, Nacho},
