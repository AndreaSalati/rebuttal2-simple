@article{thakur_clocking_2020,
  title = {Clocking the Circadian Genes in Human Embryonic Stem Cells},
  author = {Thakur, Soumyaa and Storewala, Prachi and Basak, Upasna and Jalan, Nitya and Pethe, Prasad},
  year = 2020,
