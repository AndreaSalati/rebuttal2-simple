@misc{marri_multiscale_2024,
  title = {A Multiscale Model of the Mammalian Liver Circadian Clock Supports Synchronization of Autonomous Oscillations by Intercellular Communication},
  author = {Marri, Daniel and Kana, Omar and Filipovic, David and Sluka, James P. and Liu, Shengnan and Zhang, Qiang and Bhattacharya, Sudin},
