@article{saunders_perturbmultimodal_2025,
  title = {Perturb-{{Multimodal}}: {{A}} Platform for Pooled Genetic Screens with Imaging and Sequencing in Intact Mammalian Tissue},
  shorttitle = {Perturb-{{Multimodal}}},
  author = {Saunders, Reuben A. and Allen, William E. and Pan, Xingjie and Sandhu, Jaspreet and Lu, Jiaqi and Lau, Thomas K. and Smolyar, Karina and Sullivan, Zuri A. and Dulac, Catherine and Weissman, Jonathan S. and Zhuang, Xiaowei},
