}

@article{perrin_transcriptomic_2018,
  title = {Transcriptomic Analyses Reveal Rhythmic and {{CLOCK-driven}} Pathways in Human Skeletal Muscle},
  author = {Perrin, Laurent and {Loizides-Mangold}, Ursula and Chanon, St{\'e}phanie and Gobet, C{\'e}dric and Hulo, Nicolas and Isenegger, Laura and Weger, Benjamin D and Migliavacca, Eugenia and Charpagne, Aline and Betts, James A and Walhin, Jean-Philippe and Templeman, Iain and Stokes, Keith and Thompson, Dylan and Tsintzas, Kostas and Robert, Maud and Howald, Cedric and Riezman, Howard and Feige, Jerome N and Karagounis, Leonidas G and Johnston, Jonathan D and Dermitzakis, Emmanouil T and Gachon, Fr{\'e}d{\'e}ric and Lefai, Etienne and Dibner, Charna},
  editor = {Takahashi, Joseph S},
  year = 2018,
  month = apr,
  journal = {eLife},
  volume = {7},
  pages = {e34114},
  publisher = {eLife Sciences Publications, Ltd},
  issn = {2050-084X},
  doi = {10.7554/eLife.34114},
  urldate = {2025-08-19},
  abstract = {Circadian regulation of transcriptional processes has a broad impact on cell metabolism. Here, we compared the diurnal transcriptome of human skeletal muscle conducted on serial muscle biopsies in vivo with profiles of human skeletal myotubes synchronized in vitro. More extensive rhythmic transcription was observed in human skeletal muscle compared to in vitro cell culture as a large part of the in vivo mRNA rhythmicity was lost in vitro. siRNA-mediated clock disruption in primary myotubes significantly affected the expression of \textasciitilde 8\% of all genes, with impact on glucose homeostasis and lipid metabolism. Genes involved in GLUT4 expression, translocation and recycling were negatively affected, whereas lipid metabolic genes were altered to promote activation of lipid utilization. Moreover, basal and insulin-stimulated glucose uptake were significantly reduced upon CLOCK depletion. Our findings suggest an essential role for the circadian coordination of skeletal muscle glucose homeostasis and lipid metabolism in humans.},
  keywords = {circadian oscillators,human skeletal muscle,RNA sequencing},
  file = {/Users/salati/Zotero/storage/RM4KB3YC/Perrin et al. - 2018 - Transcriptomic analyses reveal rhythmic and CLOCK-.pdf}
}

@article{persson_petabjl_2025,
