@article{westermark_quantification_2009,
  title = {Quantification of {{Circadian Rhythms}} in {{Single Cells}}},
  author = {Westermark, P{\aa}l O. and Welsh, David K. and Okamura, Hitoshi and Herzel, Hanspeter},
