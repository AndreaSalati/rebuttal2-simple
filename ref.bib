@article{ma_transcriptomic_2025,
  title = {Transcriptomic {{DN3}} Clock Neuron Subtypes Regulate {{Drosophila}} Sleep},
  author = {Ma, Dingbang and Le, Jasmine Quynh and Dai, Xihuimin and D{\'i}az, Madelen M. and Abruzzi, Katharine C. and Rosbash, Michael},
