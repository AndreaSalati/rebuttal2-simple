  langid = {english},
  keywords = {Cell division,Computational models,Statistical methods,Systems biology,Transcriptomics},
  file = {/Users/salati/Zotero/storage/GJGSPTCI/Lederer et al. - 2024 - Statistical inference with a manifold-constrained RNA velocity model uncovers cell cycle speed modul.pdf}
}

