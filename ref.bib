@article{vanbeurden_single_2022,
  title = {Single Cell Model for Re-entrainment to a Shifted Light Cycle},
  author = {Van Beurden, Anouk W. and Schoonderwoerd, Robin A. and Tersteeg, Mayke M. H. and De Torres Guti{\'e}rrez, Pablo and Michel, Stephan and Blommers, Ruben and Rohling, Jos H. T. and Meijer, Johanna H.},
  year = 2022,
