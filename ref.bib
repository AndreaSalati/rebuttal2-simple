@article{szalata_transformers_2024,
  title = {Transformers in Single-Cell Omics: A Review and New Perspectives},
  shorttitle = {Transformers in Single-Cell Omics},
  author = {Sza{\l}ata, Artur and Hrovatin, Karin and Becker, S{\"o}ren and {Tejada-Lapuerta}, Alejandro and Cui, Haotian and Wang, Bo and Theis, Fabian J.},
