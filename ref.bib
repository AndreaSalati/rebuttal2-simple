@article{welsh_individual_1995,
  title = {Individual Neurons Dissociated from Rat Suprachiasmatic Nucleus Express Independently Phased Circadian Firing Rhythms},
  author = {Welsh, David K and Logothetis, Diomedes E and Meister, Markus and Reppert, Steven M},
  year = 1995,
  month = apr,
  journal = {Neuron},
  volume = {14},
  number = {4},
  pages = {697--706},
  issn = {0896-6273},
  doi = {10.1016/0896-6273(95)90214-7},
  urldate = {2025-05-13},
  abstract = {Within the mammalian hypothalamus, the suprachiasmatic nucleus (SCN) contains a circadian clock for timing of diverse neuronal, endocrine, and behavioral rhythms. By culturing cells from neonatal rat SCN on fixed microelectrode arrays, we have been able to record spontaneous action potentials from individual SCN neurons for days or weeks, revealing prominent circadian rhythms in firing rate. Despite abundant functional synapses, circadian rhythms expressed by neurons in the same culture are not synchronized. After reversible blockade of neuronal firing lasting 2.5 days, circadian firing rhythms re-emerge with unaltered phases. These data suggest that the SCN contains a large population of autonomous, single-cell circadian oscillators, and that synapses formed in vitro are neither necessary for operation of these oscillators nor sufficient for synchronizing them.},
  file = {/Users/salati/Zotero/storage/2JCZ8RSH/0896627395902147.html}
}

@article{welz_bmal1driven_2019,
  title = {{{BMAL1-Driven Tissue Clocks Respond Independently}} to {{Light}} to {{Maintain Homeostasis}}},
  author = {Welz, Patrick-Simon and Zinna, Valentina M. and Symeonidi, Aikaterini and Koronowski, Kevin B. and Kinouchi, Kenichiro and Smith, Jacob G. and Guill{\'e}n, In{\'e}s Mar{\'i}n and Castellanos, Andr{\'e}s and Furrow, Stephen and Arag{\'o}n, Ferr{\'a}n and Crainiciuc, Georgiana and Prats, Neus and Caballero, Juan Mart{\'i}n and Hidalgo, Andr{\'e}s and {Sassone-Corsi}, Paolo and Benitah, Salvador Aznar},
  year = 2019,
  month = may,
  journal = {Cell},
  volume = {177},
  number = {6},
  pages = {1436-1447.e12},
  issn = {0092-8674},
  doi = {10.1016/j.cell.2019.05.009},
  urldate = {2024-05-03},
  abstract = {Circadian rhythms control organismal physiology throughout the day. At the cellular level, clock regulation is established by a self-sustained Bmal1-dependent transcriptional oscillator network. However, it is~still unclear how different tissues achieve a synchronized rhythmic physiology. That is, do they respond independently to environmental signals, or require interactions with each other to do so? We show that unexpectedly, light synchronizes the Bmal1-dependent circadian machinery in single tissues in the absence of Bmal1 in all other tissues. Strikingly, light-driven tissue autonomous clocks occur without rhythmic feeding behavior and are lost in constant darkness. Importantly, tissue-autonomous Bmal1 partially sustains homeostasis in otherwise arrhythmic and prematurely aging animals. Our results therefore support a two-branched model for the daily synchronization of tissues: an autonomous response branch, whereby light entrains circadian clocks without any commitment of~other Bmal1-dependent clocks, and a memory branch using other Bmal1-dependent clocks to ``remember'' time in the absence of external cues.},
  file = {/Users/salati/Zotero/storage/QP95MNCW/Welz et al. - 2019 - BMAL1-Driven Tissue Clocks Respond Independently t.pdf;/Users/salati/Zotero/storage/ZFGICMFC/S0092867419305070.html}
}

