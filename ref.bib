  pages = {605--616},
  publisher = {Elsevier},
  issn = {0092-8674, 1097-4172},
  doi = {10.1016/j.cell.2007.02.047},
  urldate = {2026-02-22},
  abstract = {{$<$}h2{$>$}Summary{$<$}/h2{$><$}p{$>$}Molecular mechanisms of the mammalian circadian clock have been studied primarily by genetic perturbation and behavioral analysis. Here, we used bioluminescence imaging to monitor \emph{Per2} gene expression in tissues and cells from clock mutant mice. We discovered that \emph{Per1} and \emph{Cry1} are required for sustained rhythms in peripheral tissues and cells, and in neurons dissociated from the suprachiasmatic nuclei (SCN). \emph{Per2} is also required for sustained rhythms, whereas \emph{Cry2} and \emph{Per3} deficiencies cause only period length defects. However, oscillator network interactions in the SCN can compensate for \emph{Per1} or \emph{Cry1} deficiency, preserving sustained rhythmicity in mutant SCN slices and behavior. Thus, behavior does not necessarily reflect cell-autonomous clock phenotypes. Our studies reveal previously unappreciated requirements for \emph{Per1, Per2,} and \emph{Cry1} in sustaining cellular circadian rhythmicity and demonstrate that SCN intercellular coupling is essential not only to synchronize component cellular oscillators but also for robustness against genetic perturbations.{$<$}/p{$>$}},
  langid = {english},
  pmid = {17482552},
  file = {/Users/salati/Zotero/storage/R64Y4MFE/Liu et al. - 2007 - Intercellular Coupling Confers Robustness against Mutations in the SCN Circadian Clock Network.pdf}
}

@article{liu_reconstructing_2017,
  title = {Reconstructing Cell Cycle Pseudo Time-Series via Single-Cell Transcriptome Data},
  author = {Liu, Zehua and Lou, Huazhe and Xie, Kaikun and Wang, Hao and Chen, Ning and Aparicio, Oscar M. and Zhang, Michael Q. and Jiang, Rui and Chen, Ting},
