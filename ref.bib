@article{behbehani_singlecell_2012,
  title = {Single-Cell Mass Cytometry Adapted to Measurements of the Cell Cycle},
  author = {Behbehani, Gregory K. and Bendall, Sean C. and Clutter, Matthew R. and Fantl, Wendy J. and Nolan, Garry P.},
  year = 2012,
  journal = {Cytometry Part A},
  volume = {81A},
  number = {7},
  pages = {552--566},
  issn = {1552-4930},
  doi = {10.1002/cyto.a.22075},
  urldate = {2026-06-19},
  abstract = {Mass cytometry is a recently introduced technology that utilizes transition element isotope-tagged antibodies for protein detection on a single-cell basis. By circumventing the limitations of emission spectral overlap associated with fluorochromes utilized in traditional flow cytometry, mass cytometry currently allows measurement of up to 40 parameters per cell. Recently, a comprehensive mass cytometry analysis was described for the hematopoietic differentiation program in human bone marrow from a healthy donor. The current study describes approaches to delineate cell cycle stages utilizing 5-iodo-2-deoxyuridine (IdU) to mark cells in S phase, simultaneously with antibodies against cyclin B1, cyclin A, and phosphorylated histone H3 (S28) that characterize the other cell cycle phases. Protocols were developed in which an antibody against phosphorylated retinoblastoma protein (Rb) at serines 807 and 811 was used to separate cells in G0 and G1 phases of the cell cycle. This mass cytometry method yielded cell cycle distributions of both normal and cancer cell populations that were equivalent to those obtained by traditional fluorescence cytometry techniques. We applied this to map the cell cycle phases of cells spanning the hematopoietic hierarchy in healthy human bone marrow as a prelude to later studies with cancers and other disorders of this lineage. \copyright{} 2012 International Society for Advancement of Cytometry},
  copyright = {Copyright \copyright{} 2012 International Society for Advancement of Cytometry},
  langid = {english},
  keywords = {cell cycle,flow cytometry,hematopoiesis,iododeoxyuridine,mass cytometry,retinoblastoma},
  file = {/Users/salati/Zotero/storage/HFMUNKND/Behbehani et al. - 2012 - Single-cell mass cytometry adapted to measurements of the cell cycle.pdf;/Users/salati/Zotero/storage/2XTLRB87/cyto.a.html}
}

