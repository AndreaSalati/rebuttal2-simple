  issn = {1097-4172},
  doi = {10.1016/j.cell.2021.12.045},
  abstract = {Single-cell (sc)RNA-seq, together with RNA velocity and metabolic labeling, reveals cellular states and transitions at unprecedented resolution. Fully exploiting these data, however, requires kinetic models capable of unveiling governing regulatory functions. Here, we introduce an analytical framework dynamo (https://github.com/aristoteleo/dynamo-release), which infers absolute RNA velocity, reconstructs continuous vector fields that predict cell fates, employs differential geometry to extract underlying regulations, and ultimately predicts optimal reprogramming paths and perturbation outcomes. We highlight dynamo's power to overcome fundamental limitations of conventional splicing-based RNA velocity analyses to enable accurate velocity estimations on a metabolically labeled human hematopoiesis scRNA-seq dataset. Furthermore, differential geometry analyses reveal mechanisms driving early megakaryocyte appearance and elucidate asymmetrical regulation within the PU.1-GATA1 circuit. Leveraging the least-action-path method, dynamo accurately predicts drivers of numerous hematopoietic transitions. Finally, in silico perturbations predict cell-fate diversions induced by gene perturbations. Dynamo, thus, represents an important step in advancing quantitative and predictive theories of cell-state transitions.},
  langid = {english},
  pmcid = {PMC9332140},
  pmid = {35108499},
  keywords = {Algorithms,cell-fate transitions,differential geometry analysis,dynamical systems theory,dynamo,Female,Gene Expression Regulation,hematopoiesis,Hematopoiesis,Hematopoietic Stem Cells,HL-60 Cells,Humans,in silico perturbation,Kinetics,least action path,Models Biological,RNA Jacobian,RNA Messenger,RNA metabolic labeling,Single-Cell Analysis,Staining and Labeling,Transcriptome,vector field reconstruction},
  file = {/Users/salati/Zotero/storage/D873HSZJ/Qiu et al. - 2022 - Mapping transcriptomic vector fields of single cel.pdf}
}

