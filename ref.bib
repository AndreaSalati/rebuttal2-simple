@misc{fischer_sailing_2024,
  title = {Sailing in High-Dimensional Spaces: {{Low-dimensional}} Embeddings through Angle Preservation},
  shorttitle = {Sailing in High-Dimensional Spaces},
  author = {Fischer, Jonas and Ma, Rong},
