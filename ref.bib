  author = {Qiu, Xiaojie and Zhang, Yan and {Martin-Rufino}, Jorge D. and Weng, Chen and Hosseinzadeh, Shayan and Yang, Dian and Pogson, Angela N. and Hein, Marco Y. and Hoi Joseph Min, Kyung and Wang, Li and Grody, Emanuelle I. and Shurtleff, Matthew J. and Yuan, Ruoshi and Xu, Song and Ma, Yian and Replogle, Joseph M. and Lander, Eric S. and Darmanis, Spyros and Bahar, Ivet and Sankaran, Vijay G. and Xing, Jianhua and Weissman, Jonathan S.},
  year = 2022,
